# Copy to .env.local (gitignored; read by agent-eval and the scripts). One credential per gateway.

# OpenCode Go subscription — experiments/opencode-go--*. https://opencode.ai/docs/go/
OPENCODE_API_KEY=

# Any OpenRouter-compatible endpoint — experiments/openrouter--*. Defaults to openrouter.ai.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api        # a proxy: its base URL without /v1
# AGENT_EVAL_DOCKER_IMAGE=my-node24-image-with-ca      # only if the endpoint needs a private CA
# NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/my-ca.crt

# Claude subscription — experiments/claude-subscription--*: `claude setup-token` prints it.
CLAUDE_CODE_OAUTH_TOKEN=

# ChatGPT subscription — experiments/codex-subscription--*: no variable. Run `codex login` (ChatGPT)
# on the host; ~/.codex/auth.json (or $CODEX_HOME/auth.json) is copied into each sandbox.

# Optional: evaluate another checkout of the skill (default: ../skills/gravity-ui).
# GRAVITY_UI_SKILL_DIR=/abs/path/to/skills/gravity-ui
