{
  "name": "gravity-ui-skill-evals",
  "private": true,
  "type": "module",
  "description": "Agent evaluations of the gravity-ui skill on Gravity UI coding tasks, powered by @vercel/agent-eval.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "eval": "agent-eval",
    "eval:run": "node scripts/eval-run.ts",
    "eval:smoke": "node scripts/eval-run.ts --smoke",
    "eval:dry": "agent-eval --dry",
    "playground": "agent-eval playground",
    "export-results": "node scripts/export-results.ts",
    "verify-evals": "node scripts/verify-evals.ts",
    "typecheck": "tsc --noEmit",
    "drop-infra-results": "node scripts/drop-infra-results.ts",
    "prune-results": "node scripts/prune-results.ts",
    "rejudge-results": "node scripts/rejudge-results.ts",
    "classify-results": "node scripts/classify-results.ts",
    "merge-openrouter-results": "node scripts/merge-openrouter-results.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/agent-eval": "^2.6.0",
    "typescript": "^7.0.2"
  }
}
